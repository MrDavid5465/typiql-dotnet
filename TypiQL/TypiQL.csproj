<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- COMPUTERNAME is Windows-only; USER is its rough Linux/macOS equivalent.
         Without a fallback, an unset COMPUTERNAME produced the malformed
         version "0.0.0-" (empty pre-release label) on non-Windows, which
         made NuGet's restore task fail with no logged error at all. -->
    <BuildMachineName Condition=" '$(COMPUTERNAME)' != '' ">$(COMPUTERNAME)</BuildMachineName>
    <BuildMachineName Condition=" '$(BuildMachineName)' == '' AND '$(USER)' != '' ">$(USER)</BuildMachineName>
    <BuildMachineName Condition=" '$(BuildMachineName)' == '' ">local</BuildMachineName>
    <Version Condition=" '$(Version)' == '' ">0.0.0-$(BuildMachineName)</Version>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.0.123" />
    <PackageReference Include="GraphQL" Version="7.2.1" />
    <PackageReference Include="GraphQL.MicrosoftDI" Version="7.2.1" />
    <PackageReference Include="GraphQL.Server.All" Version="7.2.0" />
    <PackageReference Include="GraphQL.Server.Ui.GraphiQL" Version="7.2.0" />
    <PackageReference Include="GraphQL.SystemTextJson" Version="7.2.1" />
    <PackageReference Include="LinqKit.Core" Version="1.2.3" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="6.0.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="MongoDB.Driver" Version="2.30.0" />
    <PackageReference Include="MongoDB.Driver.GridFS" Version="2.30.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.2" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <!-- Transitive via MongoDB.Driver's compression support; pinned directly
         since 2.30.0 still pulls the vulnerable versions of both. -->
    <PackageReference Include="SharpCompress" Version="0.48.0" />
    <PackageReference Include="Snappier" Version="1.3.1" />
    <PackageReference Include="System.DirectoryServices" Version="7.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="7.0.0" />
    <PackageReference Include="System.Reactive" Version="5.0.0" />
  </ItemGroup>

</Project>
